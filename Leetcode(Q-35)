class Solution {
    public int searchInsert(int[] arr, int x) {
        int n=arr.length-1;
int s=0,l=n;
int mid=(s+l)/2;
while(s<=l){
     mid=(s+l)/2;
    if(arr[mid]==x)return mid;
    else if(arr[mid]<x)s=mid+1;
    else l=mid-1;
}
if(arr[mid]>x)return mid;

 return mid+1;

    }
}