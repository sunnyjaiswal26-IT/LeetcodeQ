class Solution {
    public int maxScore(String s) {
        int n=s.length();
        int []arr1=new int [s.length()];
       if(s.charAt(n-1)=='1') arr1[s.length()-1]=1;
        int []arr0=new int [s.length()];
        if(s.charAt(0)=='0')arr0[0]=1;
        for(int i=1;i<s.length();i++){
            if(s.charAt(i)=='0')arr0[i]=1;
            arr0[i] +=arr0[i-1];
        }
        for(int i=n-2;i>=0;i--){
           if(s.charAt(i)=='1')arr1[i]=1;
         arr1[i] +=arr1[i+1];
        }
        int max=-9999;
for(int i=n-1;i>0;i--){
max=Math.max(max,(arr1[i]+arr0[i-1]));
}
return max;
    }
}
